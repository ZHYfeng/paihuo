[Unit]
Description=paihuo - personal agent dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yu/git/paihuo/workdir
ExecStart=/home/yu/git/paihuo/workdir/paihuo --addr 0.0.0.0:8080 --db /home/yu/git/paihuo/workdir/paihuo.db --no-browser-auth
EnvironmentFile=/home/yu/git/paihuo/workdir/token.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
